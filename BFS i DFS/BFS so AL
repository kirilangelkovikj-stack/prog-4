#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, m;
    cin >> n >> m;
    vector<vector<int>> AL(n);

    for (int i = 0; i < m; i++) {
        int u, v;
        cin >> u >> v;

        AL[u].push_back(v);
        AL[v].push_back(u);
    }

    vector<bool> visited(n, false);
    queue<int> q;

    int start = 0;
    visited[start] = true;
    q.push(start);

    while (!q.empty()) {
        int u = q.front();
        q.pop();
        cout << u << " ";
        for (int v : AL[u]) {
            if (!visited[v]) {
                visited[v] = true;
                q.push(v);
            }
        }
    }
    return 0;
}

